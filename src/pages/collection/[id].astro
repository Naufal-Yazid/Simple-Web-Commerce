---
import Layout from '../../layouts/Layout.astro';
import { products, getProductById } from '../../data/products';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  return products.map((product) => ({
    params: { id: String(product.id) },
    props: { product },
  }));
};

const { product } = Astro.props;

// Parse description into sections
const descSections = product.desc.split('\n\n').map(section => {
  const lines = section.split('\n');
  const title = lines[0];
  const items = lines.slice(1);
  return { title, items };
});
---

<Layout title={`${product.name} | Imperia Culverin`} description={product.desc.split('\n')[0]}>

  <section id="product-detail" class="pt-24 md:pt-32 pb-24 px-6 md:px-12">
    <a href="/collection" class="flex items-center text-[10px] font-bold mb-12 uppercase tracking-[0.2em] group" id="back-to-collection">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 w-4 transition group-hover:-translate-x-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Back to Collection
    </a>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 max-w-7xl mx-auto">
      <div class="aspect-[4/5] overflow-hidden bg-gray-50 shadow-sm">
        <img src={product.img} alt={product.name} class="w-full h-full object-cover" />
      </div>
      <div class="space-y-10 flex flex-col justify-center">
        <div class="space-y-4 text-center lg:text-left">
          <p class="text-ice-blue font-bold uppercase tracking-[0.4em] text-[10px]">{product.category}</p>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-normal leading-tight tracking-tighter">{product.name}</h1>
          {product.discount ? (
            <div class="flex items-center gap-4 justify-center lg:justify-start">
              <span class="discount-badge text-xs px-2 py-1">{product.discount}</span>
              <span class="text-xl md:text-2xl font-light text-gray-400 line-through">{product.originalPrice}</span>
              <span class="text-2xl md:text-3xl font-medium text-red-600">{product.price}</span>
            </div>
          ) : (
            <p class="text-2xl md:text-3xl font-light text-gray-400">{product.price}</p>
          )}
        </div>

        <!-- Size Selector -->
        <div class="space-y-4 pt-6 border-t border-gray-100 text-center lg:text-left">
          <h4 class="text-[10px] font-bold uppercase tracking-widest text-gray-500">Available Sizes</h4>
          <div class="flex gap-3 justify-center lg:justify-start">
            {product.size.map((s: string) => (
              <span class="w-12 h-12 flex items-center justify-center text-xs font-bold border border-gray-200 hover:border-black transition cursor-pointer">{s}</span>
            ))}
          </div>
        </div>

        <!-- Description Sections -->
        {descSections.map((section) => (
          <div class="space-y-4 pt-6 border-t border-gray-100 text-center lg:text-left">
            <h4 class="text-[10px] font-bold uppercase tracking-widest text-gray-500">{section.title}</h4>
            <ul class="space-y-2 text-gray-600 font-light text-sm md:text-base leading-relaxed">
              {section.items.map((item: string) => (
                <li class="flex items-start justify-center lg:justify-start">
                  <span class="w-1.5 h-1.5 bg-gray-300 rounded-full mt-2 mr-3 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="pt-6">
          <a href={product.shopeeLink} target="_blank" rel="noopener noreferrer" class="btn-square w-full bg-black text-white py-5 block text-center hover:bg-ice-blue hover:text-black transition shadow-xl" id="order-shopee">
            Shop Now
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
