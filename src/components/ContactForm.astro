---

<div class="bg-[#FBFBFB] p-8 md:p-16 border border-gray-100 flex flex-col justify-center shadow-sm">
  <form class="space-y-10" id="contact-form">
    <div class="space-y-2">
      <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400" for="contact-name">Full Name</label>
      <input type="text" id="contact-name" placeholder="Enter your full name" class="w-full bg-transparent border-b border-gray-200 py-3 text-sm focus:border-black outline-none transition" required />
    </div>
    <div class="space-y-2">
      <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400" for="contact-email">Email Address</label>
      <input type="email" id="contact-email" placeholder="name@domain.com" class="w-full bg-transparent border-b border-gray-200 py-3 text-sm focus:border-black outline-none transition" required />
    </div>
    <div class="space-y-2">
      <label class="text-[10px] font-bold uppercase tracking-widest text-gray-400" for="contact-message">Message</label>
      <textarea rows="4" id="contact-message" placeholder="What would you like to tell us?" class="w-full bg-transparent border-b border-gray-200 py-3 text-sm focus:border-black outline-none transition resize-none" required></textarea>
    </div>
    <div class="pt-6">
      <button type="submit" id="contact-submit" class="btn-square w-full bg-black text-white py-5 hover:bg-ice-blue hover:text-black transition duration-500 shadow-md">
        Submit Inquiry
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Thank you for your inquiry! We will get back to you soon.');
    (form as HTMLFormElement).reset();
  });
</script>
